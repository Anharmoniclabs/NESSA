[Unit]
Description=NESSA always-warm fast conversation model
After=network.target

[Service]
ExecStart=%h/.local/share/nessa/runtime/bin/ollama serve
ExecStartPost=/usr/bin/python3 %h/Projects/NESSA/scripts/warm_chat.py
Environment="OLLAMA_HOST=127.0.0.1:11436"
Environment="OLLAMA_MODELS=%h/.local/share/nessa/models"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_CONTEXT_LENGTH=8192"
Environment="OLLAMA_KEEP_ALIVE=-1"
Environment="OLLAMA_NO_CLOUD=1"
Restart=on-failure
RestartSec=3
TimeoutStartSec=180

[Install]
WantedBy=default.target
